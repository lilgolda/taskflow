# Plantilla de variables de entorno de TaskFlow (Docker Compose).
# Cópiala a .env y cambia los valores:
#   cp .env.example .env        (Linux / macOS / Git Bash)
#   Copy-Item .env.example .env (PowerShell)
# .env NUNCA se sube al repositorio. Los valores de aquí son solo de ejemplo, no reales.

# --- MongoDB ---
# Usuario y contraseña del administrador de Mongo (se crean la primera vez que se inicia el volumen).
# Usa solo letras y números en la contraseña para no tener que codificarla en la URI.
MONGO_ROOT_USER=cambia_este_usuario
MONGO_ROOT_PASSWORD=cambiaEstaClave123
# Nombre de la base de datos de TaskFlow (la API lo recibe como DB_NAME)
MONGO_DB=taskflow

# --- API ---
# Tamaño máximo del pool de conexiones de Mongoose
MAX_POOL_SIZE=10

# --- Frontend ---
# URL pública de la API que usará el navegador (se inyecta al compilar React)
VITE_API_URL=http://localhost:3000/api
